{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ficha de Personagem (Digital Character Sheet)",
  "type": "object",
  "required": [
    "core_stats",
    "derived_stats",
    "skills_tree",
    "witcher_specifics",
    "armor_layers"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "nome": {"type": "string"},
        "raca": {"type": "string"},
        "classe": {"type": "string"},
        "nivel": {"type": "integer", "minimum": 0},
        "xp_atual": {"type": "integer", "minimum": 0},
        "historia": {"type": "string"},
        "imagem_url": {"type": ["string", "null"], "format": "uri"},
        "ouro": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "atributos": {
      "type": "object",
      "properties": {
        "hp_max": {"type": "integer", "minimum": 0},
        "hp_atual": {"type": "integer", "minimum": 0},
        "mp_max": {"type": "integer", "minimum": 0},
        "ataque": {"type": "integer", "minimum": 0},
        "defesa": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "habilidades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "descricao", "dado"],
        "properties": {
          "nome": {"type": "string"},
          "descricao": {"type": "string"},
          "dado": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "inventario": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "tipo", "valor", "efeito"],
        "properties": {
          "nome": {"type": "string"},
          "tipo": {"type": "string"},
          "valor": {"type": "integer"},
          "efeito": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "core_stats": {
      "type": "object",
      "required": [
        "INT",
        "REF",
        "DEX",
        "BODY",
        "SPD",
        "EMP",
        "CRA",
        "WILL",
        "LUCK"
      ],
      "properties": {
        "INT": {"type": "integer", "minimum": 0},
        "REF": {"type": "integer", "minimum": 0},
        "DEX": {"type": "integer", "minimum": 0},
        "BODY": {"type": "integer", "minimum": 0},
        "SPD": {"type": "integer", "minimum": 0},
        "EMP": {"type": "integer", "minimum": 0},
        "CRA": {"type": "integer", "minimum": 0},
        "WILL": {"type": "integer", "minimum": 0},
        "LUCK": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "derived_stats": {
      "type": "object",
      "required": [
        "Stun",
        "Run",
        "Leap",
        "HP",
        "Stamina",
        "Vigor",
        "Recovery"
      ],
      "properties": {
        "Stun": {"type": "integer", "minimum": 0},
        "Run": {"type": "integer", "minimum": 0},
        "Leap": {"type": "integer", "minimum": 0},
        "HP": {"type": "integer", "minimum": 0},
        "Stamina": {"type": "integer", "minimum": 0},
        "Vigor": {"type": "integer", "minimum": 0},
        "Recovery": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "skills_tree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "stat_base", "pontos_investidos", "modificadores"],
        "properties": {
          "nome": {"type": "string"},
          "stat_base": {"type": ["string", "null"]},
          "pontos_investidos": {"type": "integer", "minimum": 0},
          "modificadores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["fonte", "valor"],
              "properties": {
                "fonte": {"type": "string"},
                "valor": {"type": "integer"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "witcher_specifics": {
      "type": "object",
      "required": ["toxicity", "focus"],
      "properties": {
        "toxicity": {
          "type": "object",
          "required": ["atual", "max"],
          "properties": {
            "atual": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "focus": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "armor_layers": {
      "type": "object",
      "required": ["cabeca", "tronco", "pernas"],
      "properties": {
        "cabeca": {
          "type": "object",
          "required": ["sp", "reliability"],
          "properties": {
            "sp": {"type": "integer", "minimum": 0},
            "reliability": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "tronco": {
          "type": "object",
          "required": ["sp", "reliability"],
          "properties": {
            "sp": {"type": "integer", "minimum": 0},
            "reliability": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "pernas": {
          "type": "object",
          "required": ["sp", "reliability"],
          "properties": {
            "sp": {"type": "integer", "minimum": 0},
            "reliability": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
